{
  "name": "compositor-win",
  "productName": "Compositor",
  "version": "1.0.0",
  "description": "Free open-source image editor for Windows",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-all.js",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "jszip": "^3.10.1",
    "onnxruntime-web": "^1.30.0",
    "sharp": "^0.33.5",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.compositor.win",
    "productName": "Compositor",
    "copyright": "MIT License",
    "files": [
      "electron/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "compositor",
      "repo": "compositor-win"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "sharp@0.33.5": true
  }
}
